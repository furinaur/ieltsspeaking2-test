# Set these in Netlify: Site configuration -> Environment variables
# (for local testing with `npm run dev:netlify`, copy this file to .env and fill it in)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# Optional: override the Gemini model used by the functions (default: gemini-3.8-flash)
# GEMINI_MODEL="gemini-3.8-flash"
